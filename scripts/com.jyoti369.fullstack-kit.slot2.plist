<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jyoti369.fullstack-kit.slot2</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/debojyoti.mandal/Code/Personal/fullstack-kit/scripts/run_daily.sh</string>
    </array>

    <!-- Slot 2: 1:30 PM IST -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/fullstack-kit-slot2.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/fullstack-kit-slot2.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
